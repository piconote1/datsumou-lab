{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "datsumou-lab",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "datsumou-lab-db","database_id": "d25be174-29c0-4741-a00f-1768206c7699",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "datsumou-lab-media","preview_bucket_name": "datsumou-lab-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
