---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import PagePortableImage from "../../components/PagePortableImage.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteShortTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const pageOrigin = Astro.url.origin;
const pageUrl = `${pageOrigin}/pages/${slug}`;
const seo = getSeoMeta(page, {
	siteTitle: siteShortTitle,
	siteUrl: pageOrigin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const PAGE_META: Record<string, { title: string; description: string }> = {
	operator: {
		title: "運営者情報・編集方針とサイトの目的",
		description:
			"脱毛研究室の運営者情報（まいか）、運営開始時期、お問い合わせ先、情報の収集方法や医療従事者・医療機関ではない旨の編集方針について記載しています。",
	},
	privacy: {
		title: "プライバシーポリシー・個人情報の取り扱い",
		description:
			"脱毛研究室における個人情報の取得と利用目的、アクセス解析ツールやCookieの取り扱い、第三者への提供に関するプライバシーポリシーを定めています。",
	},
	disclaimer: {
		title: "広告（PR）の扱いと医療情報の免責について",
		description:
			"脱毛研究室におけるアフィリエイト広告の表記方針、公式情報に基づく比較スタンス、および医療・健康に関する情報の免責事項について詳しく説明しています。",
	},
};
const pageMeta = PAGE_META[slug];
const resolvedTitle = pageMeta?.title ?? seo.title;
const resolvedDescription = pageMeta?.description ?? seo.description;
const pageSchema: Record<string, unknown> =
	slug === "operator"
		? {
				"@context": "https://schema.org",
				"@type": "ProfilePage",
				"@id": `${pageUrl}#webpage`,
				url: pageUrl,
				name: `${resolvedTitle} | ${siteShortTitle}`,
				inLanguage: "ja",
				isPartOf: { "@id": `${pageOrigin}/#website` },
				about: { "@id": `${pageOrigin}/#organization` },
				dateModified: page.data.updatedAt.toISOString(),
				mainEntity: {
					"@type": "Person",
					"@id": `${pageUrl}#person`,
					name: "まいか",
					url: pageUrl,
					sameAs: ["https://www.threads.com/@maika.datsumou"],
					worksFor: { "@id": `${pageOrigin}/#organization` },
				},
			}
		: {
				"@context": "https://schema.org",
				"@type": "WebPage",
				"@id": `${pageUrl}#webpage`,
				url: pageUrl,
				name: `${resolvedTitle} | ${siteShortTitle}`,
				inLanguage: "ja",
				isPartOf: { "@id": `${pageOrigin}/#website` },
				about: { "@id": `${pageOrigin}/#organization` },
				dateModified: page.data.updatedAt.toISOString(),
			};
---

<Base
	title={resolvedTitle}
	pageTitle={seo.ogTitle}
	description={resolvedDescription}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
	breadcrumbs={[
		{ name: "ホーム", url: "/" },
		{ name: page.data.title, url: `/pages/${slug}` },
	]}
	schema={pageSchema}
>
	<article class="band page">
		<div class="frame page__layout">
			<header class="page__header">
				<h1 class="page__title" {...page.edit.title}>{page.data.title}</h1>
			</header>

			<div class="prose page__body" {...page.edit.content}>
				<PortableText
					value={page.data.content}
					components={slug === "operator" ? { type: { image: PagePortableImage } } : undefined}
				/>
			</div>
		</div>
	</article>
</Base>

<style>
	.page {
		padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(4rem, 3rem + 4vw, 7rem);
	}

	.page__layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--spacing-8);
	}

	.page__title {
		font-size: var(--font-size-display);
		line-height: 1.05;
		max-width: 22ch;
	}

	@media (min-width: 960px) {
		.page__layout {
			grid-template-columns: minmax(14rem, 1fr) minmax(0, var(--content-width));
			column-gap: clamp(2rem, 1rem + 4vw, 6rem);
		}

		.page__header {
			position: sticky;
			top: calc(var(--nav-height) + var(--spacing-8));
			align-self: start;
		}
	}
</style>
