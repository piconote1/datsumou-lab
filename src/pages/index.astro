---
import { getEmDashEntry, getTermsForEntries } from "emdash";
import Base from "../layouts/Base.astro";
import PostRow from "../components/PostRow.astro";
import PickupCard from "../components/PickupCard.astro";

// トップ専用の説明文・SNS用の画像・正規URL（2026-11-14 SEO対応）。
// サイト設定のキャッチフレーズが空で、説明文が出ていなかったため、ここで指定する。
const HOME_TITLE = "脱毛研究室｜医療脱毛クリニックの選び方・料金・脱毛機を公式情報で比較";
const HOME_DESCRIPTION =
	"医療脱毛クリニックを選ぶときの確認ポイントを、公式に公開されている情報をもとに整理するサイト。料金・追加費用・契約と解約・脱毛機・通い方まで、決める順番に沿って解説します。";
const homeCanonical = `${Astro.url.origin}/`;
const homeImage = `${Astro.url.origin}/brand/og-default.png`;

// トップの構成：カテゴリー（大分類）ごとに、トップに出したい記事だけを固定で並べる。
// 固定にしていない記事は、トップには出ない（各見出しの「すべて見る」ボタンから、カテゴリーのページで読める）。
// 分類はカテゴリー1本だけ。見出しの名前と slug は、管理画面のカテゴリーと同じにする。
type Group = { slug: string; title: string; featured?: boolean; pinned: string[] };
const GROUPS: Group[] = [
	{
		slug: "select",
		title: "脱毛を選ぶ",
		featured: true,
		pinned: ["datsumo-selection-guide", "datsumo-compare-guide", "datsumo-price-compare", "datsumo-gentlemax-pro", "datsumo-tsudo-barai"],
	},
	{
		// 地域別の比較記事（2026-11-20 追加）。専用カテゴリー「地域で選ぶ」（slug: region）。
		slug: "region",
		title: "地域で選ぶ",
		featured: true,
		pinned: ["datsumo-tokyo", "datsumo-osaka", "datsumo-fukuoka", "datsumo-nagoya", "datsumo-sapporo"],
	},
	{
		slug: "basic",
		title: "基礎を知る",
		pinned: ["clinic-vs-salon-guide", "course-parts-guide", "datsumo-machine-guide"],
	},
	{
		slug: "money",
		title: "お金と契約",
		pinned: ["price-count-guide", "datsumo-count-guide", "contract-cancel-guide"],
	},
	{
		slug: "visit",
		title: "通う・受ける",
		pinned: ["access-continue-guide", "prep-checklist-guide", "datsumo-vio-guide", "pain-skin-guide"],
	},
	{ slug: "faq", title: "よくある質問", pinned: ["datsumo-faq"] },
];

const fetchEntry = async (slug: string) => {
	try {
		const { entry } = await getEmDashEntry("posts", slug);
		return entry ?? null;
	} catch {
		return null;
	}
};
const groups = (
	await Promise.all(
		GROUPS.map(async (g) => ({
			...g,
			posts: (await Promise.all(g.pinned.map(fetchEntry))).filter(
				(p): p is NonNullable<typeof p> => p !== null,
			),
		})),
	)
).filter((g) => g.posts.length > 0);

const ids = groups.flatMap((g) => g.posts.map((p) => p.data.id));
const termsByEntry = ids.length
	? await getTermsForEntries("posts", ids, "category")
	: new Map();
const labelsOf = (id: string) =>
	(termsByEntry.get(id) ?? []).map((t: any) => ({ slug: t.slug, label: t.label }));
---

<Base title={HOME_TITLE} description={HOME_DESCRIPTION} canonical={homeCanonical} image={homeImage}>
	<section class="band hero">
		<div class="frame">
			<div class="hero__card">
				<div class="hero__copy">
					<p class="hero__eyebrow">公式情報だけで比較する医療脱毛ガイド</p>
					<h1 class="hero__title">医療脱毛クリニックの料金・脱毛機・条件を公式情報で比較</h1>
					<p class="hero__lead">
						総額と追加費用、使われている脱毛機、契約・解約の注意点まで、各クリニック公式サイトの公開情報をもとに中立に整理しています。
					</p>
					<div class="hero__actions">
						<a href="/posts/datsumo-price-compare" class="hero__btn hero__btn--primary">全身5回の料金を比較する</a>
						<a href="/category/region" class="hero__btn hero__btn--mint">地域別クリニック</a>
						<a href="/posts/datsumo-selection-guide" class="hero__btn hero__btn--ghost">選び方ガイド</a>
					</div>
				</div>
				<div class="hero__stage" role="region" aria-roledescription="carousel" aria-label="医療脱毛クリニックのイメージ" data-hero>
					<img class="hero__img is-active" src="/hero/hero-1-960.webp" srcset="/hero/hero-1-640.webp 640w, /hero/hero-1-960.webp 960w, /hero/hero-1-1280.webp 1280w, /hero/hero-1.webp 1672w" sizes="(min-width: 900px) 600px, 92vw" alt="医療クリニックの受付" width="1600" height="900" fetchpriority="high" decoding="async" />
					<img class="hero__img hero__img--machine" src="/hero/hero-2-960.webp" srcset="/hero/hero-2-640.webp 640w, /hero/hero-2-960.webp 960w, /hero/hero-2-1280.webp 1280w, /hero/hero-2.webp 1600w" sizes="(min-width: 900px) 600px, 92vw" alt="医療脱毛の施術室と脱毛機" width="1600" height="1067" loading="lazy" decoding="async" />
					<div class="hero__dots" role="group" aria-label="表示する画像を選ぶ">
						<button type="button" class="hero__dot is-active" aria-label="1枚目を表示" aria-current="true"></button>
						<button type="button" class="hero__dot" aria-label="2枚目を表示"></button>
					</div>
				</div>
			</div>
		</div>
	</section>
	{
		groups.length === 0 ? (
			<section class="band section">
				<div class="frame">
					<div class="empty-state">
						<h2 class="empty-state__title">記事は、まだありません</h2>
						<p class="empty-state__text">管理画面から、最初の記事を作成してください。</p>
						<div class="empty-state__actions">
							<a href="/_emdash/admin/content/posts/new" class="btn">記事を作成する</a>
						</div>
					</div>
				</div>
			</section>
		) : (
			<section class="band section home-wrap">
				<div class="frame">
					<div class="home-panel">
						{groups.map((g) => (
							<section class="home-group" aria-label={g.title}>
								<h2 class="home-section-title">{g.title}</h2>
								{g.featured ? (
									<div class="pickup-grid">
										{g.posts.map((post) => (
											<PickupCard post={post} tags={labelsOf(post.data.id)} />
										))}
									</div>
								) : (
									<ol class="post-list">
										{g.posts.map((post) => (
											<li>
												<PostRow post={post} labels={labelsOf(post.data.id)} />
											</li>
										))}
									</ol>
								)}
								<p class="home-more">
									<a href={`/category/${g.slug}`}>「{g.title}」の記事をすべて見る</a>
								</p>
							</section>
						))}
					</div>
				</div>
			</section>
		)
	}
</Base>

<style>
	.hero {
		padding: clamp(1rem, 2.5vw, 1.75rem) 0 0;
	}
	.hero__card {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		gap: clamp(1rem, 2.5vw, 2rem);
		align-items: center;
		padding: clamp(1.25rem, 3vw, 2rem);
		background: #fff;
		border: 1px solid #e3e6e9;
		border-radius: 16px;
		box-shadow: 0 1px 2px rgb(16 24 40 / 0.04);
	}
	.hero__copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.9rem;
		min-width: 0;
	}
	.hero__eyebrow {
		margin: 0;
		padding: 0.25rem 0.75rem;
		border-radius: 999px;
		background: #e4f6ef;
		color: #0c5442;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.03em;
	}
	.hero__title {
		margin: 0;
		color: #172641;
		font-size: clamp(1.375rem, 1.1rem + 1.25vw, 1.95rem);
		font-weight: 800;
		line-height: 1.4;
		letter-spacing: 0.01em;
	}
	.hero__lead {
		margin: 0;
		color: #3a4862;
		font-size: 0.9375rem;
		line-height: 1.75;
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 0.2rem;
	}
	.hero__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0.6rem 1.15rem;
		border-radius: 999px;
		font-size: 0.9375rem;
		font-weight: 700;
		line-height: 1.3;
		text-decoration: none;
		transition: background 0.15s ease, transform 0.15s ease;
	}
	.hero__btn--primary {
		background: #172641;
		color: #fff;
	}
	.hero__btn--primary:hover {
		background: #2a3d63;
		transform: translateY(-1px);
	}
	.hero__btn--mint {
		background: #d7f2e8;
		border: 1px solid #8bd4ba;
		color: #0c5442;
	}
	.hero__btn--mint:hover {
		background: #c3ebd9;
	}
	.hero__btn--ghost {
		background: #fff;
		border: 1px solid #c2cfdb;
		color: #172641;
	}
	.hero__btn--ghost:hover {
		background: #f3f6f9;
	}
	.hero__stage {
		position: relative;
		overflow: hidden;
		border-radius: 12px;
		aspect-ratio: 16 / 10;
		width: 100%;
		min-height: 240px;
		background: #eef1f4;
	}
	.hero__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		opacity: 0;
		transition: opacity 1.2s ease;
	}
	.hero__img--machine {
		object-position: 72% 50%;
	}
	.hero__img:not(.hero__img--machine) {
		object-position: 62% 50%;
	}
	.hero__img.is-active {
		opacity: 1;
	}
	.hero__dots {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 4px;
		display: flex;
		justify-content: center;
		gap: 4px;
	}
	.hero__dot {
		position: relative;
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
	}
	.hero__dot::before {
		content: "";
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.65);
		box-shadow: 0 0 0 1px rgba(31, 41, 51, 0.25);
	}
	.hero__dot.is-active::before {
		background: #1f2933;
		box-shadow: 0 0 0 1px #fff;
	}
	@media (max-width: 860px) {
		.hero__card {
			grid-template-columns: minmax(0, 1fr);
			gap: 1rem;
		}
		.hero__stage {
			aspect-ratio: 16 / 9;
			min-height: 190px;
		}
	}
	@media (max-width: 640px) {
		.hero {
			padding-top: 12px;
		}
		.hero__card {
			padding: 1rem;
			border-radius: 14px;
		}
		.hero__title {
			font-size: 1.25rem;
		}
		.hero__actions {
			width: 100%;
		}
		.hero__btn--primary {
			flex: 1 1 100%;
		}
		.hero__btn--mint,
		.hero__btn--ghost {
			flex: 1 1 calc(50% - 0.35rem);
			padding-inline: 0.75rem;
			font-size: 0.875rem;
		}
		.hero__img:not(.hero__img--machine) {
			object-position: 88% 50%;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero__img {
			transition: none;
		}
	}
</style>

<script>
	// 画像を5秒ごとに切り替える。点を押すと、その画像を表示する。マウスを乗せている間・動きを減らす設定のときは、自動で切り替えない（スマホの操作では止めない）。
	const root = document.querySelector<HTMLElement>("[data-hero]");
	if (root) {
		const imgs = Array.from(root.querySelectorAll<HTMLImageElement>(".hero__img"));
		const dots = Array.from(root.querySelectorAll<HTMLButtonElement>(".hero__dot"));
		let cur = 0;
		let paused = false;
		const show = (i: number) => {
			cur = (i + imgs.length) % imgs.length;
			imgs.forEach((el, k) => el.classList.toggle("is-active", k === cur));
			dots.forEach((el, k) => {
				el.classList.toggle("is-active", k === cur);
				if (k === cur) el.setAttribute("aria-current", "true");
				else el.removeAttribute("aria-current");
			});
		};
		imgs.forEach((el) => el.removeAttribute("loading"));
		dots.forEach((el, k) => el.addEventListener("click", () => show(k)));
		// マウスを乗せている間だけ止める。スマホ（タッチ）では、触れても止めない
		root.addEventListener("pointerenter", (e) => {
			if (e.pointerType === "mouse") paused = true;
		});
		root.addEventListener("pointerleave", (e) => {
			if (e.pointerType === "mouse") paused = false;
		});
		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (!reduce && imgs.length > 1) {
			setInterval(() => {
				if (!paused && !document.hidden) show(cur + 1);
			}, 5000);
		}
	}
</script>
