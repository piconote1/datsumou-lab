---
import { getEmDashCollection, getTermsForEntries, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import PostRow from "../components/PostRow.astro";
import PickupCard from "../components/PickupCard.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const settings = await getSiteSettings();
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

// トップの構成：カテゴリー（大分類）ごとに記事カードを並べる。分類はカテゴリー1本だけ。
// 並び順はここで固定する。記事にカテゴリーを付ければ、その見出しの下に自動で出る。
type Group = { slug: string; title: string; featured?: boolean };
const GROUPS: Group[] = [
	{ slug: "select", title: "脱毛を選ぶ", featured: true },
	{ slug: "basic", title: "基礎を知る" },
	{ slug: "money", title: "お金と契約" },
	{ slug: "visit", title: "通う・受ける" },
	{ slug: "faq", title: "よくある質問" },
];
// 見出しの中での並び順（先に書いた記事が上）。書いていない記事は、公開が新しい順で、その後ろに並ぶ。
const ORDER = [
	"datsumo-selection-guide",
	"datsumo-price-compare",
	"clinic-vs-salon-guide",
	"course-parts-guide",
	"datsumo-machine-guide",
	"price-count-guide",
	"datsumo-count-guide",
	"contract-cancel-guide",
	"access-continue-guide",
	"prep-checklist-guide",
	"datsumo-vio-guide",
	"pain-skin-guide",
	"datsumo-faq",
];
// トップに出さない記事（ほかの記事・ガイドの中から読まれる）
const HIDDEN_SLUGS = ["datsumo-compare-guide"];

const { entries: all } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 100,
});
const visible = all.filter((p) => !HIDDEN_SLUGS.includes(p.id));
const ids = visible.map((p) => p.data.id);
const termsByEntry = ids.length
	? await getTermsForEntries("posts", ids, "category")
	: new Map();
const labelsOf = (id: string) =>
	(termsByEntry.get(id) ?? []).map((t: any) => ({ slug: t.slug, label: t.label }));
const rank = (slug: string) => {
	const i = ORDER.indexOf(slug);
	return i === -1 ? 999 : i;
};
const placed = new Set<string>();
const resolved = GROUPS.map((g) => {
	const posts = visible
		.filter((p) => labelsOf(p.data.id).some((l: any) => l.slug === g.slug))
		.sort((a, b) => rank(a.id) - rank(b.id));
	posts.forEach((p) => placed.add(p.id));
	return { ...g, posts };
});
// どの見出しにも入っていない公開記事（カテゴリー未設定など）は、いちばん下に出す。
const others = visible.filter((p) => !placed.has(p.id));
const groups = [
	...resolved.filter((g) => g.posts.length > 0),
	...(others.length > 0
		? [{ slug: "others", title: "そのほかの記事", featured: false, posts: others }]
		: []),
];
---

<Base title={siteTitle} description={siteTagline}>
	{
		groups.length === 0 ? (
			<section class="band section">
				<div class="frame">
					<div class="empty-state">
						<h2 class="empty-state__title">記事は、まだありません</h2>
						<p class="empty-state__text">管理画面から、最初の記事を作成してください。</p>
						<div class="empty-state__actions">
							<a href="/_emdash/admin/content/posts/new" class="btn">記事を作成する</a>
						</div>
					</div>
				</div>
			</section>
		) : (
			<section class="band section home-wrap">
				<div class="frame">
					<div class="home-panel">
						{groups.map((g) => (
							<section class="home-group" aria-label={g.title}>
								<h2 class="home-section-title">{g.title}</h2>
								{g.featured ? (
									<div class="pickup-grid">
										{g.posts.map((post) => (
											<PickupCard post={post} tags={labelsOf(post.data.id)} />
										))}
									</div>
								) : (
									<ol class="post-list">
										{g.posts.map((post) => (
											<li>
												<PostRow post={post} labels={labelsOf(post.data.id)} />
											</li>
										))}
									</ol>
								)}
							</section>
						))}
					</div>
				</div>
			</section>
		)
	}
</Base>
