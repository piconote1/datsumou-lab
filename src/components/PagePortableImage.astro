---
interface Props {
	node: {
		_type?: "image";
		asset?: { _ref?: string; url?: string };
		alt?: string;
		caption?: string;
		title?: string;
		width?: number;
		height?: number;
		displayWidth?: number;
		displayHeight?: number;
		alignment?: string;
	};
}

const { node } = Astro.props;
const src =
	node?.asset?.url ??
	(node?.asset?._ref ? `/_emdash/api/media/file/${node.asset._ref}` : "");
const width = node?.displayWidth ?? node?.width;
const height = node?.displayHeight ?? node?.height;
---

{
	src && (
		<figure
			class:list={[
				"emdash-image",
				node?.alignment && `emdash-image--align-${node.alignment}`,
			]}
		>
			<img
				src={src}
				alt={node?.alt ?? ""}
				title={node?.title}
				width={width}
				height={height}
				loading="eager"
				decoding="async"
				fetchpriority="high"
			/>
			{node?.caption && <figcaption>{node.caption}</figcaption>}
		</figure>
	)
}

<style>
	.emdash-image {
		margin: 1.5rem 0;
	}
	.emdash-image img {
		display: block;
		max-width: 100%;
		height: auto;
	}
	.emdash-image figcaption {
		margin-top: 0.5rem;
		font-size: 0.875rem;
		color: var(--color-muted);
	}
</style>
