---
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	post: ContentEntry<InferCollectionData<"posts">>;
}
const { post } = Astro.props;
const href = `/posts/${post.id}`;
const title = post.data.title || "Untitled";
---

<article class="pickup">
	<a href={href} class="pickup__media" tabindex="-1" aria-hidden="true">
		{
			post.data.featured_image ? (
				<Image image={post.data.featured_image} sizes="(min-width: 900px) 360px, 100vw" />
			) : (
				<img src="/brand/banner.svg" alt="" loading="lazy" />
			)
		}
	</a>
	<h2 class="pickup__title"><a href={href}>{title}</a></h2>
	<a href={href} class="btn btn--readmore">READ MORE</a>
</article>

<style>
	.pickup {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-4);
		padding: var(--spacing-8) var(--spacing-8) var(--spacing-6);
		background: #fff;
		border: 1px solid var(--color-border-subtle);
		border-radius: 2px;
		text-align: center;
	}
	.pickup__media {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--gray-bg);
	}
	.pickup__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.pickup__title {
		margin: 0;
		font-size: var(--font-size-base);
		font-weight: 700;
		line-height: 1.7;
	}
	.pickup__title a {
		color: var(--gray-text);
		text-decoration: none;
	}
	.pickup__title a:hover {
		text-decoration: underline;
	}
</style>
